/* Exercicio de teste do Assignment 2 */
sensor temperatura:analogico(porta 1), claridade:digital(porta 2).
atuador cortina:digital(porta 3), ventilador:analogico(porta 4).

ler(x).
w <- (6+8)*(5-7).
se (((temperatura < 30))) entao
    cortina <- 1.
    ventilador <- 80.
senao
    cortina <- 0.
    ventilador <- 0.
fim_se.
se claridade > 20 entao cortina <- 0. fim_se.
asd <- 8 / x.
asd <- asd + 2.
escrever(asd * 2).
enquanto (asd > 1)
    asd <- asd - 1.
fim_enquanto.